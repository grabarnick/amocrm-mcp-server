{
  "name": "amocrm-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP сервер для интеграции с amoCRM (CRUD по leads/contacts/notes, OAuth2)",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "dev:http": "node --loader ts-node/esm src/http-index.ts",
    "dev:streamable": "node --loader ts-node/esm src/streamable-index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http-index.js",
    "start:streamable": "node dist/streamable-index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test-api": "node --loader ts-node/esm test-api.ts",
    "test-mcp": "node --loader ts-node/esm test-mcp.ts",
    "test-http": "node --loader ts-node/esm test-http-mcp.ts",
    "test-streamable": "node --loader ts-node/esm test-streamable-mcp.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
