{
  "name": "amocrm-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP сервер для интеграции с amoCRM (CRUD по leads/contacts/notes, OAuth2)",
  "scripts": {
    "dev": "ts-node --transpile-only --esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}

