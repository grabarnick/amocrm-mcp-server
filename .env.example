# AmoCRM API Configuration
# Базовый URL вашего аккаунта amoCRM
AMO_BASE_URL=https://example.amocrm.ru

# OAuth2 credentials (получите в настройках интеграции amoCRM)
AMO_CLIENT_ID=your_client_id_here
AMO_CLIENT_SECRET=your_client_secret_here
AMO_REDIRECT_URI=https://your.app/oauth/callback

# OAuth2 токены (заполняются после первичной авторизации)
# Получите через инструмент amocrm.exchangeAuthCode или вручную
AMO_ACCESS_TOKEN=
AMO_REFRESH_TOKEN=

# Примечание:
# - access_token действителен ограниченное время (обычно 24 часа)
# - refresh_token используется для автоматического обновления access_token
# - сервер автоматически обновит access_token при истечении срока
